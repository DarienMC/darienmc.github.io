---
import "../styles/global.css";

import MainHead from '../components/MainHead.astro';
import NavBar from '../components/NavBar.astro';
import Footer from '../components/Footer.astro';
import SideBar from '../components/SideBar.astro';

interface Props {
	title?: string | undefined;
	description?: string | undefined;
	sideBarActiveItemID?: string | undefined;
}

const { title, description, sideBarActiveItemID } = Astro.props;
---

<html lang="en">
	<head>
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<MainHead title={title} description={description} />
	</head>
	<body>
		<NavBar />
		<div class="drawer lg:drawer-open">
			<input id="my-drawer-2" type="checkbox" class="drawer-toggle" />
			<div class="drawer-content flex flex-col items-center justify-center selection:bg-primary/40">
				<slot />
			</div>
			<SideBar sideBarActiveItemID={sideBarActiveItemID}/>
		</div>
        <Footer />
    </body>
</html>